        <Item class="LocalScript" referent="RBX100">
          <Properties>
            <string name="Name">ResponsiveLayout</string>
            <ProtectedString name="Source">local Players = game:GetService("Players")
local player = Players.LocalPlayer
local gui = script.Parent
local root = gui:WaitForChild("Root")
local header = root:WaitForChild("Header")
local sidebar = root:WaitForChild("Sidebar")
local content = root:WaitForChild("Content")
local boardPanel = content:WaitForChild("BoardPanel")
local board = boardPanel:WaitForChild("ChessBoard")
local right = content:WaitForChild("RightPanel")
local mobileNav = root:WaitForChild("MobileNav")
local camera = workspace.CurrentCamera

local function updateLayout()
    if not camera then camera = workspace.CurrentCamera end
    if not camera then return end
    local v = camera.ViewportSize
    local portrait = v.X &lt; v.Y or v.X &lt; 760
    if portrait then
        sidebar.Visible = false
        mobileNav.Visible = true
        content.Position = UDim2.fromOffset(0, 72)
        content.Size = UDim2.new(1, 0, 1, -130)
        local boardSize = math.max(250, math.min(v.X - 20, v.Y * 0.49))
        boardPanel.Size = UDim2.fromOffset(boardSize, boardSize)
        boardPanel.Position = UDim2.new(0.5, -boardSize/2, 0, 12)
        right.Size = UDim2.new(1, -24, 0, 220)
        right.Position = UDim2.new(0, 12, 0, boardSize + 30)
        right.Visible = true
        for _, child in ipairs(right:GetChildren()) do
            if child:IsA("GuiObject") then
                if child.Name == "OnlineButton" then child.Position = UDim2.fromOffset(12, 48); child.Size = UDim2.new(0.5, -18, 0, 42)
                elseif child.Name == "BotButton" then child.Position = UDim2.new(0.5, 6, 0, 48); child.Size = UDim2.new(0.5, -18, 0, 42)
                elseif child.Name == "ModesLabel" then child.Position = UDim2.fromOffset(12, 102)
                elseif child.Name:match("^Mode_") then
                    local n = ({CLASSIC=0,RAPID=1,BLITZ=2,BULLET=3})[child.Name:gsub("Mode_","")] or 0
                    child.Position = UDim2.new(0, 12+n* (math.max(58,(v.X-56)/4)), 0, 130)
                    child.Size = UDim2.new(0, math.max(52,(v.X-80)/4), 0, 36)
                elseif child.Name == "MatchTitle" then child.Visible = false
                elseif child.Name == "OpponentLabel" then child.Visible = false
                elseif child.Name == "StatusLabel" then child.Position = UDim2.fromOffset(12, 176)
                elseif child.Name == "TipLabel" then child.Visible = false end
            end
        end
    else
        sidebar.Visible = true
        mobileNav.Visible = false
        content.Position = UDim2.fromOffset(196, 76)
        content.Size = UDim2.new(1, -208, 1, -78)
        local availableW = v.X - 196 - 208 - 300
        local boardSize = math.max(320, math.min(availableW, v.Y - 150, 560))
        boardPanel.Size = UDim2.fromOffset(boardSize, boardSize)
        boardPanel.Position = UDim2.new(0, 0, 0.5, -boardSize/2)
        right.Size = UDim2.new(0, 264, 1, 0)
        right.Position = UDim2.new(1, -264, 0, 0)
        right.Visible = true
        for _, child in ipairs(right:GetChildren()) do
            if child:IsA("GuiObject") then
                child.Visible = true
                if child.Name == "OnlineButton" then child.Position = UDim2.fromOffset(16,88); child.Size = UDim2.new(1,-32,0,48)
                elseif child.Name == "BotButton" then child.Position = UDim2.fromOffset(16,146); child.Size = UDim2.new(1,-32,0,44)
                elseif child.Name == "ModesLabel" then child.Position = UDim2.fromOffset(16,210)
                elseif child.Name:match("^Mode_") then
                    local n = ({CLASSIC=0,RAPID=1,BLITZ=2,BULLET=3})[child.Name:gsub("Mode_","")] or 0
                    child.Position = UDim2.fromOffset(16+n*58,242); child.Size = UDim2.fromOffset(54,38)
                elseif child.Name == "StatusLabel" then child.Position = UDim2.fromOffset(16,300)
                elseif child.Name == "TipLabel" then child.Position = UDim2.fromOffset(16,340) end
            end
        end
    end
end

updateLayout()
if camera then camera:GetPropertyChangedSignal("ViewportSize"):Connect(updateLayout) end
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
    camera = workspace.CurrentCamera
    if camera then camera:GetPropertyChangedSignal("ViewportSize"):Connect(updateLayout) end
    updateLayout()
end)</ProtectedString>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
</roblox>