        <Item class="LocalScript" referent="RBX109">
          <Properties>
            <string name="Name">ResponsiveLayout</string>
            <ProtectedString name="Source">local gui=script.Parent
local app=gui:WaitForChild("App")
local nav=app:WaitForChild("Navigation")
local content=app:WaitForChild("Content")
local boardCard=content:WaitForChild("BoardCard")
local board=boardCard:WaitForChild("Board")
local panel=content:WaitForChild("MatchPanel")
local mobile=app:WaitForChild("MobileNavigation")
local camera=workspace.CurrentCamera

local function apply()
    camera=workspace.CurrentCamera
    if not camera then return end
    local v=camera.ViewportSize
    local portrait=v.X&lt;v.Y
    local compact=portrait or v.X&lt;900
    if compact then
        nav.Visible=false
        mobile.Visible=true
        content.Position=UDim2.fromOffset(14,78)
        content.Size=UDim2.new(1,-28,1,-154)
        local width=math.max(260,math.min(v.X-28,v.Y*.50))
        boardCard.Size=UDim2.fromOffset(width,width+50)
        boardCard.Position=UDim2.new(.5,-width/2,0,94)
        board.Size=UDim2.new(1,-32,0,width-78)
        board.Position=UDim2.fromOffset(16,62)
        panel.Position=UDim2.new(0,0,0,width+158)
        panel.Size=UDim2.new(1,0,0,310)
        panel.Visible=true
        content:WaitForChild('PageTitle').Visible=true
        content:WaitForChild('PageSubtitle').Visible=false
    else
        nav.Visible=true
        mobile.Visible=false
        content.Position=UDim2.fromOffset(208,78)
        content.Size=UDim2.new(1,-230,1,-96)
        boardCard.Size=UDim2.fromOffset(520,570)
        boardCard.Position=UDim2.fromOffset(0,102)
        board.Size=UDim2.new(1,-40,1,-92)
        board.Position=UDim2.fromOffset(20,62)
        panel.Size=UDim2.new(0,300,1,-102)
        panel.Position=UDim2.new(1,-300,0,102)
        content:WaitForChild('PageSubtitle').Visible=true
    end
end
apply()
if camera then camera:GetPropertyChangedSignal("ViewportSize"):Connect(apply) end
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
    task.defer(function()
        camera=workspace.CurrentCamera
        if camera then camera:GetPropertyChangedSignal("ViewportSize"):Connect(apply) end
        apply()
    end)
end)</ProtectedString>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="RBX110">
          <Properties>
            <string name="Name">BoardInteraction</string>
            <ProtectedString name="Source">local gui=script.Parent
local app=gui:WaitForChild("App")
local content=app:WaitForChild("Content")
local board=content:WaitForChild("BoardCard"):WaitForChild("Board")
local pieceText={
 r="♜",n="♞",b="♝",q="♛",k="♚",p="♟",
 R="♖",N="♘",B="♗",Q="♕",K="♔",P="♙"
}
local state={
 "rnbqkbnr","pppppppp","........","........",
 "........","........","PPPPPPPP","RNBQKBNR"
}
local selected=nil
local turn="w"
local function pieceAt(file,rank)
 local row=state[rank]
 if not row then return nil end
 local ch=row:sub(file,file)
 return ch=="." and nil or ch
end
local function setPiece(file,rank,ch)
 local row=state[rank]
 state[rank]=row:sub(1,file-1)..(ch or ".")..row:sub(file+1)
end
local function redraw()
 for rank=1,8 do for file=1,8 do
  local sq=board:FindFirstChild("Square_"..string.char(96+file)..(9-rank))
  if sq then
   local ch=pieceAt(file,rank)
   sq.Text=ch and (pieceText[ch] or "") or ""
   local light=((file+rank)%2==1)
   sq.BackgroundColor3=light and Color3.fromRGB(199,196,186) or Color3.fromRGB(74,69,94)
   if selected and selected.file==file and selected.rank==rank then
    sq.BackgroundColor3=Color3.fromRGB(124,94,181)
   end
  end
 end end
end
local function isWhite(ch) return ch and ch:match("%u")~=nil end
for rank=1,8 do for file=1,8 do
 local name="Square_"..string.char(96+file)..(9-rank)
 local sq=board:FindFirstChild(name)
 if sq then
  sq.Activated:Connect(function()
   local ch=pieceAt(file,rank)
   if selected then
    if selected.file==file and selected.rank==rank then
     selected=nil
    elseif ch and isWhite(ch)==(turn=="w") then
     selected={file=file,rank=rank}
    else
     local moving=pieceAt(selected.file,selected.rank)
     if moving then
      setPiece(file,rank,moving)
      setPiece(selected.file,selected.rank,nil)
      turn=(turn=="w" and "b" or "w")
     end
     selected=nil
    end
   elseif ch and isWhite(ch)==(turn=="w") then
    selected={file=file,rank=rank}
   end
   redraw()
  end)
 end
end end
redraw()</ProtectedString>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
</roblox>