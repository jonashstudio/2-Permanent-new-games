						<ProtectedString name="Source"><![CDATA[local GenBoard = require(game.ReplicatedStorage.Chess.GenerateBoard)

local Board = script.Parent.Board

local isBlack = true
repeat wait() until #game.Players:GetPlayers() > 1 
if game.ReplicatedStorage.Chess.PlayerList:InvokeServer()[1] == game.Players.LocalPlayer then
	isBlack = false
end


local BoardArray = GenBoard(Board, 8, isBlack)
local letters = require(game.ReplicatedStorage.Chess.Letters)

print(BoardArray)

BoardArray = require(game.ReplicatedStorage.Chess.BoardLayouts.Classic)(BoardArray, isBlack)

require(game.ReplicatedStorage.Chess.DisplayPieces)(BoardArray)

local firstSelected = nil

local colors = {}
local frames = {}


game.Players.PlayerRemoving:Connect(function()
	game.Players.LocalPlayer:Kick('Opponent left the game.')
end)

game.ReplicatedStorage.Chess.MovePieceFunction.OnClientInvoke = function(firstSelectedRep, new)
	local x = new[1]
	local k = new[2]
	
	
	
	BoardArray[firstSelectedRep[1]][firstSelectedRep[2]], BoardArray[x][k] = require(game.ReplicatedStorage.Chess.MovePiece)(BoardArray[firstSelectedRep[1]][firstSelectedRep[2]], BoardArray[x][k], {Y=firstSelectedRep[1], X=firstSelectedRep[2]}, {Y=x,X=k}, isBlack, BoardArray, true)
	require(game.ReplicatedStorage.Chess.DisplayPieces)(BoardArray)
end

for x, c in pairs(BoardArray) do
	for k, v in pairs(c) do
		local frame = v[1]
		frames[frame] = frame
		
		colors[frame] = frame.BackgroundColor3
		frame.MouseButton1Click:Connect(function()
			for _, v in pairs(frames) do
				v.BackgroundColor3 = colors[v]
			end
			if firstSelected and BoardArray[firstSelected[1]][firstSelected[2]][1] == BoardArray[x][k][1] then firstSelected = nil return end
			if BoardArray[x][k][2] == 0 and not firstSelected then firstSelected = nil return end
			if BoardArray[x][k][3] ~= isBlack and not firstSelected then firstSelected = nil return end
			
			if not firstSelected then
				firstSelected = {x,k}
				frame.BackgroundColor3 = Color3.new(1, 0.666667, 0)
			elseif firstSelected and BoardArray[x][k][3] == not isBlack or firstSelected and BoardArray[x][k][2] == 0 then
				local moved = false
				
				
				if moved then
					print(firstSelected[1],
						9-firstSelected[2])
					print(x,
						9-k)
					
					if game.ReplicatedStorage.Chess.MovePieceFunction:InvokeServer(
						{
							firstSelected[1],
							9-firstSelected[2]
						},
						{
							x,
							9-k
						}
						
						) then
						BoardArray[firstSelected[1]][firstSelected[2]], BoardArray[x][k], moved = require(game.ReplicatedStorage.Chess.MovePiece)(BoardArray[firstSelected[1]][firstSelected[2]], BoardArray[x][k], {Y=firstSelected[1], X=firstSelected[2]}, {Y=x,X=k}, isBlack, BoardArray)
					end
				end
				
				
				require(game.ReplicatedStorage.Chess.DisplayPieces)(BoardArray)
				firstSelected = nil
			end

		end)
		
	end
end]]></ProtectedString>
