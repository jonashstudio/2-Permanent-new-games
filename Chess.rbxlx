					<ProtectedString name="Source"><![CDATA[local Players = game:GetService('Players')

local pieces = {
	Players:GetUserThumbnailAsync(425079321, Enum.ThumbnailType.AvatarThumbnail, Enum.ThumbnailSize.Size180x180),
	Players:GetUserThumbnailAsync(118080950, Enum.ThumbnailType.AvatarThumbnail, Enum.ThumbnailSize.Size180x180),
