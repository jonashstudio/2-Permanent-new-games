				<string name="ScriptGuid">{8D8F646B-E994-408D-ACA7-289438752825}</string>
				<ProtectedString name="Source"><![CDATA[game.ReplicatedStorage.Chess.PlayerList.OnServerInvoke = function(plr)
	return game.Players:GetPlayers()
end

local lastTurn
local first
local connect
connect = game.Players.PlayerAdded:Connect(function(p)
	first = p
	connect:Disconnect()
end)

game.ReplicatedStorage.Chess.MovePieceFunction.OnServerInvoke = function(plr, a,b)
	if lastTurn == plr or (plr ~= first and not lastTurn) then return end
	lastTurn = plr
	for _, v in pairs(game.Players:GetPlayers()) do
		if plr ~= v then
			game.ReplicatedStorage.Chess.MovePieceFunction:InvokeClient(v,a,b)
			
		end
	end
	
	return true
end]]></ProtectedString>
				<int64 name="SourceAssetId">-1</int64>
