local allPieces = {}

return function(board)
	for _, v in pairs(allPieces) do
		v:Destroy()
	end
	allPieces = {}
	for _, c in pairs(board) do
		for _, v in pairs(c) do
			local piece = v[2]
			local pos = v[1].Position
			
			
			
			if piece > 0 then
				local b = Instance.new("Frame", v[1].Parent) do
					allPieces[#allPieces + 1] = b
					b.AnchorPoint = Vector2.new(0.5,0.5)
					b.Position =UDim2.fromOffset(pos.X.Offset + v[1].Size.X.Offset/2,pos.Y.Offset + v[1].Size.Y.Offset/2)
					b.BackgroundTransparency = 1
					b.Size = UDim2.fromOffset(v[1].Size.X.Offset,v[1].Size.X.Offset)
					
					local Image = Instance.new("ImageLabel", b) do
						
						Image.BackgroundTransparency = 1
						Image.Size = UDim2.fromScale(1,1)
						if v[3] then
							Image.ImageColor3 = Color3.new(0.5, 0.5, 0.5)
						else
							Image.ImageColor3 = Color3.new(1, 1, 1)
						end
						Image.Image = pieces[v[2]]
					end
					
				end
			end
		end
		
	end
