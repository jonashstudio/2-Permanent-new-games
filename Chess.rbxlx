					<ProtectedString name="Source"><![CDATA[local letters = require(script.Parent.Letters)

moveTables = require(script.Parent.MoveTables)

return function(current,new,pos1,pos2,isBlack, board, overrideLegal)
	if not moveTables[current[2]] then return current,new end
	local legal
	if overrideLegal then
		legal = true
	else
		legal = moveTables[current[2]](current,new, pos1,pos2, isBlack, board)
	end
	
	
	if legal then
		new = {new[1], current[2], current[3]}
		current = {current[1], 0, current[3]}
	end
	return current,new, legal
end]]></ProtectedString>
