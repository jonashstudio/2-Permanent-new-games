		if current[3] == new[3] and new[2] > 0 then return end

		pos1.Y = table.find(letters,pos1.Y)
		pos2.Y = table.find(letters,pos2.Y)

		local distance = pos2.X - pos1.X

		if pos1.X ~= 2 and distance > 1 or pos1.X == 2 and distance > 2 then
			return false
		end

		if pos1.X < pos2.X and pos1.Y == pos2.Y and new[2] == 0 then 
			return true
		elseif pos1.Y > pos2.Y and pos1.X < pos2.X and new[2] > 0 or pos1.Y < pos2.Y and pos1.X < pos2.X and new[2] > 0 then
			return true
		end


		return false
	end,
