		pos1.Y = table.find(letters,pos1.Y)
		pos2.Y = table.find(letters,pos2.Y)



		local found = false

		for i = -2,2 do
			if pos2.Y == pos1.Y + i and i ~= 0 then
				found = true
				break
			end
		end

		if not found then
			return false
		end

		local yDistance = math.abs(pos2.Y-pos1.Y)
		local xDistance = math.abs(pos2.X-pos1.X)


		if yDistance == 2 and xDistance == 1 or yDistance == 1 and xDistance == 2 then
			return true
