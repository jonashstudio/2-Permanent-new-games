		<Item class="Folder" referent="RBX5AB02462CAB24A8E9A73097DFABF6233">
			<Properties>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<string name="Name">Chess</string>
				<int64 name="SourceAssetId">-1</int64>
				<BinaryString name="Tags"></BinaryString>
			</Properties>
			<Item class="ModuleScript" referent="RBX68272DA6503E4B9C8B2410AC5E6EEA30">
				<Properties>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">GenerateBoard</string>
					<string name="ScriptGuid">{D07B482E-7294-41F1-900B-86E0317D2BE6}</string>
					<ProtectedString name="Source"><![CDATA[local letters = {
	'a',
	'b',
	'c',
	'd',
	'e',
	'f',
	'g',
	'h',
	'i',
	'j',
	'k',
	'l',
	'm',
	'n',
	'o',
	'p',
	'q',
	'r',
	's',
	't',
	'u',
	'v',
	'w',
	'x',
	'y',
	'z'
}

return function(board, size, isBlack)
	size = math.clamp(size,1,#letters)
	local TileSize = UDim2.fromOffset(board.AbsoluteSize.X/size, board.AbsoluteSize.X/size)
	
	local BoardArray = {}
	
	for y = 0, size-1 do
		for x = 0, size-1 do
			local frame = Instance.new("TextButton", board)
			frame.Text = ''
			frame.Size = TileSize
			frame.Position = UDim2.fromOffset(y*TileSize.X.Offset, x*TileSize.X.Offset)
			
			local label = Instance.new("TextLabel", frame) do
				label.Size = UDim2.fromScale(1,1)
				if isBlack then
					label.Text = ("%s%s"):format(letters[y+1], (x+1))
				else
					label.Text = ("%s%s"):format(letters[y+1], (size-(x+1))+1)
				end
				
				label.BackgroundTransparency = 1
			end
	
			
			
			if isBlack then
				frame.Name = ("%s%s"):format(letters[y+1], (x+1))
			else
				frame.Name = ("%s%s"):format(letters[y+1], (size-(x+1))+1)
			end
			
			if not BoardArray[letters[y+1]] then
				BoardArray[letters[y+1]] = {}
			end
			
			BoardArray[letters[y+1]][(size-(x+1))+1] = {frame,0}
			
			frame.BorderSizePixel = 3
			frame.BorderColor3 = Color3.new(0,0,0)
			
			
			if isBlack then
				if (x + y) % 2 ~= 1 then
					frame.BackgroundColor3 = Color3.new(0.470588, 0.470588, 0.470588)
				else
					frame.BackgroundColor3 = Color3.new(0.835294, 0.835294, 0.835294)
				end
			else
				if (x + y) % 2 ~= 0 then
					frame.BackgroundColor3 = Color3.new(0.470588, 0.470588, 0.470588)
				else
					frame.BackgroundColor3 = Color3.new(0.835294, 0.835294, 0.835294)
				end
			end
			
		end
	end
	
	
	return BoardArray
end]]></ProtectedString>
					<int64 name="SourceAssetId">-1</int64>
					<BinaryString name="Tags"></BinaryString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXA87C4118FEAD4D678FCE3B28C1737FDA">
