	valueRow.Size = UDim2.new(1, -8, 0, 48)
	valueRow.Parent = rewardSection
	valueBox = makeTextBox(valueRow, "Amount / speed / jump / timer", UDim2.fromOffset(0, 4), UDim2.new(1, 0, 0, 38))

