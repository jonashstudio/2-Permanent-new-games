		local list = Players:GetPlayers()
		if #list == 0 then notify("No other players are in this server.", true); return end
		nextPlayerIndex = (nextPlayerIndex % #list) + 1
		targetBox.Text = list[nextPlayerIndex].Name
		selectedTarget = list[nextPlayerIndex].Name
	end, DEEP_PURPLE, 38)
