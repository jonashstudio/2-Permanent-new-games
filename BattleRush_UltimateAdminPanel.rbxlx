      <Item class="LocalScript" referent="RBXB3A4EC991E754191BD986B8D97AF7AC4">
        <Properties>
          <string name="Name">BattleRushAdmin.client.lua</string>
          <ProtectedString name="Source">-- Battle Rush static StarterGui UI binder. All visible UI objects are editable in Studio build mode.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local player = Players.LocalPlayer
local gui = script.Parent
local panel = gui:WaitForChild("AdminPanel")
local openButton = gui:WaitForChild("OpenAdminPanel")
local remotes = ReplicatedStorage:WaitForChild("BattleRushAdminRemotes")
local AdminAction = remotes:WaitForChild("AdminAction")
local GetSnapshot = remotes:WaitForChild("GetSnapshot")
local targetBox = panel:WaitForChild("TargetPlayer")
local status = panel:WaitForChild("StatusBar")
local ok, snapshot = pcall(function() return GetSnapshot:InvokeServer() end)
local isAdmin = ok and type(snapshot) == "table" and snapshot.isAdmin == true
panel.Visible = false
openButton.Visible = isAdmin
if not isAdmin then return end
local function send(action, extra)
    local payload = extra or {}
    payload.action = action
    payload.target = targetBox.Text
    AdminAction:FireServer(payload)
end
openButton.Activated:Connect(function() panel.Visible = not panel.Visible end)
panel.Header.ClosePanel.Activated:Connect(function() panel.Visible = false end)
for _, obj in ipairs(panel.CommandList:GetDescendants()) do
    if obj:IsA("TextButton") and obj.Name:sub(1,8) == "Action__" then
        local action = obj.Name:sub(9)
        obj.Activated:Connect(function()
            if action:sub(1,13) == "TriggerEvent_" then
                local eventName = action:sub(14):gsub("_", " ")
                if eventName == "Random" then eventName = "Random Event" end
                send("TriggerEvent", {eventName = eventName})
            else
                send(action)
            end
        end)
    end
end
</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
</roblox>