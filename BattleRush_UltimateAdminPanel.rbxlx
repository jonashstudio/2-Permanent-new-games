        <Properties>
          <string name="Name">Config</string>
          <ProtectedString name="Source">-- Battle Rush Ultimate Admin Panel
-- IMPORTANT: Replace the sample owner UserId with your real Roblox UserId before publishing.
local Config = {}

-- Server-only permission source. Never move this config into a LocalScript.
Config.OwnerUserIds = {
	[123456789] = true, -- REPLACE 123456789 with your Roblox UserId.
}

-- Optional default admins. Persistent admins added through the panel are saved in DataStore.
Config.AdminUserIds = {
	-- [111111111] = true,
}
Config.ModeratorUserIds = {
	-- [222222222] = true,
}

Config.DataStoreEnabled = true
Config.AdminRosterDataStore = "BattleRush_AdminRoster_v1"
Config.BanDataStore = "BattleRush_Bans_v1"

Config.CommandsEnabled = true
Config.AutoCreateArena = true
Config.ArenaName = "BattleRushAdminAbuseArena"
Config.EventDuration = 40
Config.EventBreakDuration = 8
Config.MaxFlySpeed = 58
Config.MaxWalkSpeed = 64
Config.MaxJumpPower = 120
Config.MaxAnnouncementLength = 140
Config.MaxReasonLength = 100
Config.RemoteCooldown = 0.25

-- Role permissions. Owner has every permission. Admin and Moderator are deliberately limited.
Config.RolePermissions = {
	Owner = { All = true },
	Admin = {
		PlayerAbilities = true,
		Moderation = true,
		BattleControl = true,
		FunCommands = true,
		GameManagement = true,
		AdminAbuse = true,
		ViewLogs = true,
	},
	Moderator = {
		PlayerAbilities = true,
		Moderation = true,
		ViewLogs = true,
	},
}

Config.Events = {
	"Meteor Shower",
	"Rising Lava",
	"Lightning Storm",
	"Disaster Rain",
	"Tornado",
	"Earthquake",
	"Low Gravity",
}

return Config
</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="RBX94B6885B251149098486DA148B16A014">
    <Item class="Script" referent="RBXEA7E176AA28B4989954A1DDB2DF46D52">
      <Properties>
        <string name="Name">BattleRushAdmin.server.lua</string>
        <ProtectedString name="Source">-- Battle Rush Ultimate Admin Panel - server authority layer
-- Place in ServerScriptService. All client actions are re-checked here.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local DataStoreService = game:GetService("DataStoreService")
local TextService = game:GetService("TextService")
local MessagingService = game:GetService("MessagingService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local Teams = game:GetService("Teams")
local TextChatService = game:GetService("TextChatService")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")

local packageFolder = ReplicatedStorage:WaitForChild("BattleRushAdmin")
local Config = require(packageFolder:WaitForChild("Config"))

local remotes = ReplicatedStorage:FindFirstChild("BattleRushAdminRemotes") or Instance.new("Folder")
remotes.Name = "BattleRushAdminRemotes"
remotes.Parent = ReplicatedStorage

local function getRemote(className: string, name: string)
	local item = remotes:FindFirstChild(name)
	if item and item.ClassName == className then
		return item
	end
	if item then item:Destroy() end
	item = Instance.new(className)
	item.Name = name
	item.Parent = remotes
	return item
end

local AdminAction = getRemote("RemoteEvent", "AdminAction") :: RemoteEvent
local AdminUpdate = getRemote("RemoteEvent", "AdminUpdate") :: RemoteEvent
local FlyControl = getRemote("RemoteEvent", "FlyControl") :: RemoteEvent
local GetSnapshot = getRemote("RemoteFunction", "GetSnapshot") :: RemoteFunction

local rosterStore
local banStore
if Config.DataStoreEnabled then
	local okRoster, storeRoster = pcall(function()
		return DataStoreService:GetDataStore(Config.AdminRosterDataStore)
	end)
	if okRoster then rosterStore = storeRoster end
	local okBan, storeBan = pcall(function()
		return DataStoreService:GetDataStore(Config.BanDataStore)
	end)
	if okBan then banStore = storeBan end
end

local roster: {[string]: string} = {}
for userId, _ in pairs(Config.AdminUserIds) do roster[tostring(userId)] = "Admin" end
for userId, _ in pairs(Config.ModeratorUserIds) do roster[tostring(userId)] = "Moderator" end
if rosterStore then
	local ok, saved = pcall(function() return rosterStore:GetAsync("Roster") end)
	if ok and type(saved) == "table" then
		for id, role in pairs(saved) do
			if type(id) == "string" and (role == "Admin" or role == "Moderator") then
				roster[id] = role
			end
		end
	else
		warn("[BattleRushAdmin] Could not load admin roster. Studio API access may need enabling.")
	end
end

local commandLogs = {}
local lastActionAt: {[number]: number} = {}
local lastFlyAt: {[number]: number} = {}
local playerState: {[number]: {[string]: any}} = {}
local godConnections: {[number]: RBXScriptConnection} = {}
local invisibleOriginals: {[number]: {[Instance]: number}} = {}
local collisionOriginals: {[number]: {[BasePart]: boolean}} = {}
local returnCFrames: {[number]: CFrame} = {}
local mutedPlayers: {[number]: boolean} = {}
local serverLocked = false
local doubleXP = false
local abuseActive = false
local abuseCycleToken = 0
local activeEventName: string? = nil
local eventToken = 0
local roundToken = 0
local activeTimer = 0
local previousGravity = Workspace.Gravity
local arenaModel: Model? = nil
local hazardsFolder: Folder? = nil

local function isInteger(value: any): boolean
	return type(value) == "number" and value == value and value &gt; 0 and value &lt; math.huge and value % 1 == 0
end

local function getRole(player: Player): string?
	if Config.OwnerUserIds[player.UserId] then return "Owner" end
	return roster[tostring(player.UserId)]
end

local function hasPermission(player: Player, permission: string): boolean
	local role = getRole(player)
	if not role then return false end
	if role == "Owner" then return true end
	if not Config.CommandsEnabled and permission ~= "ToggleCommands" then return false end
	local permissions = Config.RolePermissions[role]
	return permissions ~= nil and permissions[permission] == true
end

local function sendFeedback(player: Player, message: string, isError: boolean?)
	if player and player.Parent == Players then
		AdminUpdate:FireClient(player, "Feedback", tostring(message):sub(1, 220), isError == true)
	end
end

local function sendToAdmins(kind: string, ...)
	for _, player in ipairs(Players:GetPlayers()) do
		if getRole(player) then
			AdminUpdate:FireClient(player, kind, ...)
		end
	end
end

local function addLog(actor: Player, action: string, targetText: string?)
	local entry = {
		actor = actor.Name,
		actorUserId = actor.UserId,
		action = action:sub(1, 80),
		target = (targetText or "-"):sub(1, 60),
		time = os.date("%H:%M:%S"),
	}
	table.insert(commandLogs, 1, entry)
	while #commandLogs &gt; 60 do table.remove(commandLogs) end
	sendToAdmins("LogEntry", entry)
end

local function getHumanoid(player: Player): Humanoid?
	local character = player.Character
	return character and character:FindFirstChildOfClass("Humanoid") or nil
end

local function getRoot(player: Player): BasePart?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return root and root:IsA("BasePart") and root or nil
end

local function getTarget(payload: {[string]: any}): Player?
	local id = payload.targetUserId
	if isInteger(id) then return Players:GetPlayerByUserId(id) end
	local query = payload.target
	if type(query) ~= "string" then return nil end
	query = query:sub(1, 32):lower()
	if query == "" then return nil end
	local numericId = tonumber(query)
	if isInteger(numericId) then
		local byId = Players:GetPlayerByUserId(numericId)
		if byId then return byId end
	end
	for _, player in ipairs(Players:GetPlayers()) do
		if player.Name:lower() == query or player.DisplayName:lower() == query then return player end
	end
	local matches = {}
	for _, player in ipairs(Players:GetPlayers()) do
		if player.Name:lower():sub(1, #query) == query then table.insert(matches, player) end
	end
	if #matches == 1 then return matches[1] end
	return nil
end

local function getUserIdFromPayload(payload: {[string]: any}): number?
	if isInteger(payload.targetUserId) then return payload.targetUserId end
	if isInteger(payload.userId) then return payload.userId end
	local raw = payload.userIdText or payload.target
	if type(raw) == "string" then
		local n = tonumber(raw)
		if isInteger(n) then return n end
	end
	return nil
end

local function makeArena()
	local existing = Workspace:FindFirstChild(Config.ArenaName)
	if existing and existing:IsA("Model") then
		arenaModel = existing
	else
		local model = Instance.new("Model")
		model.Name = Config.ArenaName
		model.Parent = Workspace
		arenaModel = model

		local function makePart(name: string, size: Vector3, position: Vector3, color: Color3, material: Enum.Material, anchored: boolean, transparency: number?)
			local part = Instance.new("Part")
			part.Name = name
			part.Size = size
			part.Position = position
			part.Color = color
			part.Material = material
			part.Anchored = anchored
			part.TopSurface = Enum.SurfaceType.Studs
			part.BottomSurface = Enum.SurfaceType.Inlet
			part.Transparency = transparency or 0
			part.Parent = model
			return part
		end

		makePart("StuddedArenaFloor", Vector3.new(180, 4, 180), Vector3.new(0, 10, 0), Color3.fromRGB(65, 53, 92), Enum.Material.Plastic, true)
		makePart("NorthWall", Vector3.new(180, 18, 5), Vector3.new(0, 20, -92), Color3.fromRGB(91, 35, 175), Enum.Material.SmoothPlastic, true)
		makePart("SouthWall", Vector3.new(180, 18, 5), Vector3.new(0, 20, 92), Color3.fromRGB(91, 35, 175), Enum.Material.SmoothPlastic, true)
		makePart("EastWall", Vector3.new(5, 18, 180), Vector3.new(92, 20, 0), Color3.fromRGB(91, 35, 175), Enum.Material.SmoothPlastic, true)
		makePart("WestWall", Vector3.new(5, 18, 180), Vector3.new(-92, 20, 0), Color3.fromRGB(91, 35, 175), Enum.Material.SmoothPlastic, true)
		for _, position in ipairs({Vector3.new(-55, 19, -55), Vector3.new(55, 19, -55), Vector3.new(-55, 19, 55), Vector3.new(55, 19, 55)}) do
			makePart("PurpleTower", Vector3.new(12, 18, 12), position, Color3.fromRGB(120, 45, 220), Enum.Material.Plastic, true)
		end
		local spawnFolder = Instance.new("Folder")
		spawnFolder.Name = "Spawns"
		spawnFolder.Parent = model
		for index = 1, 8 do
			local angle = (math.pi * 2 / 8) * (index - 1)
			local marker = Instance.new("Part")
			marker.Name = "Spawn" .. index
			marker.Size = Vector3.new(4, 1, 4)
			marker.Position = Vector3.new(math.cos(angle) * 62, 14, math.sin(angle) * 62)
			marker.Anchored = true
			marker.CanCollide = false
			marker.Transparency = 1
			marker.Parent = spawnFolder
		end
		local signPart = makePart("ArenaSign", Vector3.new(1, 1, 1), Vector3.new(0, 30, -82), Color3.new(1, 1, 1), Enum.Material.SmoothPlastic, true, 1)
		local billboard = Instance.new("BillboardGui")
		billboard.Name = "ArenaTitle"
		billboard.Size = UDim2.fromOffset(420, 90)
		billboard.AlwaysOnTop = true
		billboard.Parent = signPart
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Text = "BATTLE RUSH  •  ADMIN ABUSE FIGHT"
		label.TextColor3 = Color3.fromRGB(220, 170, 255)
		label.TextStrokeTransparency = 0.2
		label.Font = Enum.Font.GothamBlack
		label.TextScaled = true
		label.Parent = billboard
	end

	if arenaModel then
		hazardsFolder = arenaModel:FindFirstChild("LiveHazards") :: Folder?
		if not hazardsFolder then
			hazardsFolder = Instance.new("Folder")
			hazardsFolder.Name = "LiveHazards"
			hazardsFolder.Parent = arenaModel
		end
	end
end

if Config.AutoCreateArena then makeArena() end

local function getSpawnCFrame(index: number?): CFrame
	if arenaModel then
		local spawns = arenaModel:FindFirstChild("Spawns")
		if spawns then
			local markers = spawns:GetChildren()
			if #markers &gt; 0 then
				local marker = markers[((index or math.random(1, #markers)) - 1) % #markers + 1]
				if marker:IsA("BasePart") then return marker.CFrame + Vector3.new(0, 5, 0) end
			end
		end
	end
	return CFrame.new(0, 25, 0)
end

local function teleportToArena(player: Player, index: number?)
	local character = player.Character
	local root = getRoot(player)
	if character and root then character:PivotTo(getSpawnCFrame(index)) end
end

local function getHazards(): Folder
	if not hazardsFolder or not hazardsFolder.Parent then
		if not arenaModel then makeArena() end
		if arenaModel then
			local folder = arenaModel:FindFirstChild("LiveHazards")
			if folder and folder:IsA("Folder") then hazardsFolder = folder end
		end
	end
	if not hazardsFolder then
		local folder = Instance.new("Folder")
		folder.Name = "BattleRushLiveHazards"
		folder.Parent = Workspace
		hazardsFolder = folder
	end
	return hazardsFolder
end

local function clearHazards()
	local folder = getHazards()
	for _, child in ipairs(folder:GetChildren()) do child:Destroy() end
end

local function damageNear(position: Vector3, radius: number, amount: number)
	for _, player in ipairs(Players:GetPlayers()) do
		local root = getRoot(player)
		local humanoid = getHumanoid(player)
		if root and humanoid and humanoid.Health &gt; 0 and (root.Position - position).Magnitude &lt;= radius then
			if not player.Character:GetAttribute("BR_GodMode") then
				humanoid:TakeDamage(amount)
			end
		end
	end
end

local function spawnMeteor(token: number, small: boolean?)
	if token ~= eventToken then return end
	local folder = getHazards()
	local x, z = math.random(-75, 75), math.random(-75, 75)
	local meteor = Instance.new("Part")
	meteor.Name = "EventMeteor"
	meteor.Shape = Enum.PartType.Ball
	meteor.Size = small and Vector3.new(2.5, 2.5, 2.5) or Vector3.new(5, 5, 5)
	meteor.Material = Enum.Material.Neon
	meteor.Color = Color3.fromRGB(255, 103, 32)
	meteor.Position = Vector3.new(x, 90, z)
	meteor.Anchored = false
	meteor.CanCollide = true
	meteor.TopSurface = Enum.SurfaceType.Studs
	meteor.Parent = folder
	pcall(function() meteor:SetNetworkOwner(nil) end)
	local touched = false
	meteor.Touched:Connect(function(hit)
		if touched or token ~= eventToken then return end
		if hit:IsDescendantOf(arenaModel or Workspace) then
			touched = true
			damageNear(meteor.Position, small and 7 or 11, small and 12 or 24)
			meteor:Destroy()
		end
	end)
	Debris:AddItem(meteor, 9)
end

local function runEvent(name: string, token: number)
	if name == "Meteor Shower" then
		task.spawn(function()
			while token == eventToken and abuseActive do
				spawnMeteor(token, false)
				task.wait(0.7)
			end
		end)
	elseif name == "Rising Lava" then
		local lava = Instance.new("Part")
		lava.Name = "RisingLava"
		lava.Size = Vector3.new(160, 3, 160)
		lava.Position = Vector3.new(0, 0, 0)
		lava.Anchored = true
		lava.Material = Enum.Material.Neon
		lava.Color = Color3.fromRGB(255, 73, 35)
		lava.TopSurface = Enum.SurfaceType.Studs
		lava.Parent = getHazards()
		local lavaCooldown: {[number]: number} = {}
		lava.Touched:Connect(function(hit)
			local model = hit:FindFirstAncestorOfClass("Model")
			local player = model and Players:GetPlayerFromCharacter(model)
			local humanoid = model and model:FindFirstChildOfClass("Humanoid")
			if player and humanoid and not model:GetAttribute("BR_GodMode") then
				local now = os.clock()
				if not lavaCooldown[player.UserId] or now - lavaCooldown[player.UserId] &gt;= 1 then
					lavaCooldown[player.UserId] = now
					humanoid:TakeDamage(14)
				end
			end
		end)
		TweenService:Create(lava, TweenInfo.new(30, Enum.EasingStyle.Linear), {Position = Vector3.new(0, 22, 0)}):Play()
	elseif name == "Lightning Storm" then
		task.spawn(function()
			while token == eventToken and abuseActive do
				local x, z = math.random(-70, 70), math.random(-70, 70)
				local bolt = Instance.new("Part")
				bolt.Name = "LightningFlash"
				bolt.Anchored = true
				bolt.CanCollide = false
				bolt.Material = Enum.Material.Neon
				bolt.Color = Color3.fromRGB(140, 220, 255)
				bolt.Size = Vector3.new(2, 70, 2)
				bolt.Position = Vector3.new(x, 45, z)
				bolt.Parent = getHazards()
				damageNear(Vector3.new(x, 12, z), 13, 22)
				Debris:AddItem(bolt, 0.35)
				task.wait(1.4)
			end
		end)
	elseif name == "Disaster Rain" then
		task.spawn(function()
			while token == eventToken and abuseActive do
				spawnMeteor(token, true)
				task.wait(0.32)
			end
		end)
	elseif name == "Tornado" then
		task.spawn(function()
			local center = Vector3.new(math.random(-30, 30), 25, math.random(-30, 30))
			local funnel = Instance.new("Part")
			funnel.Name = "TornadoVisual"
			funnel.Shape = Enum.PartType.Cylinder
			funnel.Size = Vector3.new(48, 15, 15)
			funnel.CFrame = CFrame.new(center) * CFrame.Angles(0, 0, math.rad(90))
			funnel.Anchored = true
			funnel.CanCollide = false
			funnel.Material = Enum.Material.Neon
			funnel.Color = Color3.fromRGB(177, 168, 210)
			funnel.Transparency = 0.35
			funnel.Parent = getHazards()
			local elapsed = 0
			while token == eventToken and abuseActive and elapsed &lt; Config.EventDuration do
				elapsed += 0.2
				funnel.CFrame = CFrame.new(center + Vector3.new(math.sin(elapsed) * 22, math.sin(elapsed * 2) * 3, math.cos(elapsed) * 22)) * CFrame.Angles(0, elapsed * 2, math.rad(90))
				for _, player in ipairs(Players:GetPlayers()) do
					local root = getRoot(player)
					if root and (root.Position - funnel.Position).Magnitude &lt; 28 then
						local away = (root.Position - funnel.Position)
						if away.Magnitude &gt; 0 then root.AssemblyLinearVelocity += (away.Unit * 5) + Vector3.new(0, 3, 0) end
					end
				end
				task.wait(0.2)
			end
		end)
	elseif name == "Earthquake" then
		AdminUpdate:FireAllClients("ScreenShake", Config.EventDuration)
	elseif name == "Low Gravity" then
		previousGravity = Workspace.Gravity
		Workspace.Gravity = 78
	end
end

local function finishEvent(token: number?)
	if token and token ~= eventToken then return end
	if not activeEventName then
		Workspace.Gravity = previousGravity
		clearHazards()
		return
	end
	eventToken += 1
	activeEventName = nil
	Workspace:SetAttribute("BR_ActiveEvent", "")
	Workspace.Gravity = previousGravity
	clearHazards()
	AdminUpdate:FireAllClients("EventEnd")
end

local function startEvent(name: string)
	if not table.find(Config.Events, name) then return false, "Unknown event." end
	if not abuseActive then
		abuseActive = true
		Workspace:SetAttribute("BR_AdminAbuseActive", true)
		for index, player in ipairs(Players:GetPlayers()) do
			if player.Character then
				local root = getRoot(player)
				if root then returnCFrames[player.UserId] = root.CFrame end
				teleportToArena(player, index)
			end
		end
	end
	finishEvent()
	eventToken += 1
	local token = eventToken
	activeEventName = name
	Workspace:SetAttribute("BR_ActiveEvent", name)
	AdminUpdate:FireAllClients("EventStart", name, Config.EventDuration)
	runEvent(name, token)
	task.delay(Config.EventDuration, function()
		if token == eventToken then finishEvent(token) end
	end)
	return true, name .. " started."
end

local function startAbuseMode()
	if abuseActive then return false, "Admin Abuse Fight is already active." end
	abuseActive = true
	Workspace:SetAttribute("BR_AdminAbuseActive", true)
	for index, player in ipairs(Players:GetPlayers()) do
		local root = getRoot(player)
		if root then returnCFrames[player.UserId] = root.CFrame end
		if player.Character then teleportToArena(player, index) end
	end
	sendToAdmins("ModeState", true)
	abuseCycleToken += 1
	local cycleToken = abuseCycleToken
	task.spawn(function()
		while abuseActive and cycleToken == abuseCycleToken do
			local eventName = Config.Events[math.random(1, #Config.Events)]
			local ok = startEvent(eventName)
			if ok then task.wait(Config.EventDuration) end
			if abuseActive then
				if activeEventName then finishEvent() end
				task.wait(Config.EventBreakDuration)
			end
		end
	end)
	return true, "Admin Abuse Fight started. All players were moved to the arena."
end

local function endAbuseMode()
	if not abuseActive then return false, "Admin Abuse Fight is not active." end
	abuseActive = false
	abuseCycleToken += 1
	Workspace:SetAttribute("BR_AdminAbuseActive", false)
	finishEvent()
	for _, player in ipairs(Players:GetPlayers()) do
		local saved = returnCFrames[player.UserId]
		if saved and player.Character then player.Character:PivotTo(saved) end
		returnCFrames[player.UserId] = nil
	end
	sendToAdmins("ModeState", false)
	return true, "Admin Abuse Fight ended."
end

local function ensureTeam(name: string, color: BrickColor): Team
	local team = Teams:FindFirstChild(name)
	if not team then
		team = Instance.new("Team")
		team.Name = name
		team.TeamColor = color
		team.AutoAssignable = false
		team.Parent = Teams
	end
	return team :: Team
end
ensureTeam("Red", BrickColor.new("Really red"))
ensureTeam("Blue", BrickColor.new("Really blue"))

local function saveRoster()
	if not rosterStore then return false end
	local ok = pcall(function()
		rosterStore:UpdateAsync("Roster", function()
			return roster
		end)
	end)
	return ok
end

local function isOwner(player: Player): boolean
	return getRole(player) == "Owner"
end

local function banUser(userId: number, reason: string, admin: Player)
	if not banStore then return false, "Ban storage unavailable. Enable Studio API access or publish the game." end
	local data = {reason = reason:sub(1, Config.MaxReasonLength), by = admin.UserId, at = os.time()}
	local ok = pcall(function() banStore:SetAsync("u_" .. tostring(userId), data) end)
	if not ok then return false, "Could not save ban. Try again later." end
	local target = Players:GetPlayerByUserId(userId)
	if target then target:Kick("You are banned from this experience. Reason: " .. data.reason) end
	return true, "Ban saved for UserId " .. tostring(userId) .. "."
end

local function filteredBroadcast(admin: Player, raw: string): (boolean, string)
	raw = raw:sub(1, Config.MaxAnnouncementLength)
	if raw:gsub("%s", "") == "" then return false, "Enter a message first." end
	local ok, filtered = pcall(function()
		local filterResult = TextService:FilterStringAsync(raw, admin.UserId, Enum.TextFilterContext.PublicChat)
		return filterResult:GetNonChatStringForBroadcastAsync()
	end)
	if not ok or type(filtered) ~= "string" then return false, "Message could not be filtered, so it was not sent." end
	return true, filtered
end

local actionGroups: {[string]: string} = {
	Fly = "PlayerAbilities", Unfly = "PlayerAbilities", God = "PlayerAbilities", Ungod = "PlayerAbilities",
	Invisible = "PlayerAbilities", Visible = "PlayerAbilities", SpeedPlus = "PlayerAbilities", SpeedMinus = "PlayerAbilities",
	SetSpeed = "PlayerAbilities", SetJump = "PlayerAbilities", Noclip = "PlayerAbilities", Clip = "PlayerAbilities",
	Freeze = "PlayerAbilities", Unfreeze = "PlayerAbilities", Heal = "PlayerAbilities", Respawn = "PlayerAbilities",
	Bring = "PlayerAbilities", Teleport = "PlayerAbilities", Kick = "Moderation", Ban = "Moderation", Unban = "Moderation",
	Mute = "Moderation", Unmute = "Moderation", Warn = "Moderation", ViewInfo = "Moderation", Spectate = "Moderation",
	SendMessage = "Moderation", StartMatch = "BattleControl", EndMatch = "BattleControl", ResetArena = "BattleControl",
	SetTimer = "BattleControl", SetTeamRed = "BattleControl", SetTeamBlue = "BattleControl",
	Giant = "FunCommands", Tiny = "FunCommands", LowGravity = "FunCommands", HighGravity = "FunCommands",
	Launch = "FunCommands", Spin = "FunCommands", Ragdoll = "FunCommands", Effects = "FunCommands",
	StartAdminAbuse = "AdminAbuse", EndAdminAbuse = "AdminAbuse", TriggerEvent = "AdminAbuse", StopEvent = "AdminAbuse",
	Announce = "GameManagement", GlobalMessage = "GameManagement", ToggleDoubleXP = "GameManagement",
	LockServer = "GameManagement", UnlockServer = "GameManagement", Shutdown = "GameManagement",
	AddAdmin = "ManageAdmins", AddModerator = "ManageAdmins", RemoveAdmin = "ManageAdmins", ToggleCommands = "ToggleCommands",
	GiveCoins = "GameManagement", GiveXP = "GameManagement",
}

local function runAction(admin: Player, payload: {[string]: any})
	local action = payload.action
	if type(action) ~= "string" or #action &gt; 40 then return false, "Invalid command." end
	local permission = actionGroups[action]
	if not permission or not hasPermission(admin, permission) then return false, "You do not have permission for this command." end
	if not Config.CommandsEnabled and action ~= "ToggleCommands" and not isOwner(admin) then return false, "Admin commands are currently disabled." end

	local target = getTarget(payload)
	local targetText = target and target.Name or (type(payload.target) == "string" and payload.target or "-")
	local state
	if target then
		state = playerState[target.UserId] or {}
		playerState[target.UserId] = state
	end
	local humanoid = target and getHumanoid(target)
	local root = target and getRoot(target)
	local character = target and target.Character
	local value = tonumber(payload.value)

	local function needTarget()
		return target ~= nil, target and "" or "Choose an online target first."
	end

	if action == "Fly" or action == "Unfly" then
		local ok, msg = needTarget(); if not ok then return false, msg end
		if not root then return false, "Target character is not ready." end
		local enabled = action == "Fly"
		if target then target.Character:SetAttribute("BR_Flying", enabled) end
		local existing = root:FindFirstChild("BR_FlyVelocity")
		local gyro = root:FindFirstChild("BR_FlyGyro")
		if enabled then
			if not existing then
				local velocity = Instance.new("BodyVelocity")
				velocity.Name = "BR_FlyVelocity"
				velocity.MaxForce = Vector3.new(1e6, 1e6, 1e6)
				velocity.P = 25000
				velocity.Velocity = Vector3.zero
				velocity.Parent = root
			end
			if not gyro then
				local bodyGyro = Instance.new("BodyGyro")
				bodyGyro.Name = "BR_FlyGyro"
				bodyGyro.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
				bodyGyro.P = 15000
				bodyGyro.CFrame = root.CFrame
				bodyGyro.Parent = root
			end
			pcall(function() root:SetNetworkOwner(nil) end)
		else
			if existing then existing:Destroy() end
			if gyro then gyro:Destroy() end
			pcall(function() root:SetNetworkOwnershipAuto() end)
		end
		AdminUpdate:FireClient(target, "FlyState", enabled)
		return true, (enabled and "Fly enabled for " or "Fly disabled for ") .. target.Name
	elseif action == "God" or action == "Ungod" then
		local ok, msg = needTarget(); if not ok then return false, msg end
		if not humanoid or not character then return false, "Target character is not ready." end
		local enabled = action == "God"
		character:SetAttribute("BR_GodMode", enabled)
		if godConnections[target.UserId] then godConnections[target.UserId]:Disconnect(); godConnections[target.UserId] = nil end
		if enabled then
			state.oldMaxHealth = state.oldMaxHealth or humanoid.MaxHealth
			local forceField = character:FindFirstChild("BR_GodField")
			if not forceField then
				forceField = Instance.new("ForceField")
				forceField.Name = "BR_GodField"
				forceField.Visible = false
				forceField.Parent = character
			end
			humanoid.MaxHealth = 1000000
			humanoid.Health = humanoid.MaxHealth
			godConnections[target.UserId] = humanoid.HealthChanged:Connect(function()
				if character.Parent and character:GetAttribute("BR_GodMode") and humanoid.Health &lt; humanoid.MaxHealth then humanoid.Health = humanoid.MaxHealth end
			end)
		else
			local forceField = character:FindFirstChild("BR_GodField")
			if forceField then forceField:Destroy() end
			humanoid.MaxHealth = state.oldMaxHealth or 100
			humanoid.Health = math.min(humanoid.Health, humanoid.MaxHealth)
		end
		return true, (enabled and "God Mode enabled for " or "God Mode disabled for ") .. target.Name
	elseif action == "Invisible" or action == "Visible" then
		local ok, msg = needTarget(); if not ok then return false, msg end
		if not character then return false, "Target character is not ready." end
		if action == "Invisible" then
			invisibleOriginals[target.UserId] = {}
			for _, descendant in ipairs(character:GetDescendants()) do
				if descendant:IsA("BasePart") then
					invisibleOriginals[target.UserId][descendant] = descendant.Transparency
					descendant.Transparency = 1
				elseif descendant:IsA("Decal") or descendant:IsA("Texture") then
					invisibleOriginals[target.UserId][descendant] = descendant.Transparency
					descendant.Transparency = 1
				end
			end
			character:SetAttribute("BR_Invisible", true)
		else
			for instance, oldTransparency in pairs(invisibleOriginals[target.UserId] or {}) do
				if instance and instance.Parent then
					pcall(function()
						local propertyInstance = instance :: any
						propertyInstance.Transparency = oldTransparency
					end)
				end
			end
			invisibleOriginals[target.UserId] = nil
			character:SetAttribute("BR_Invisible", false)
		end
		return true, (action == "Invisible" and "Invisible mode enabled for " or "Visibility restored for ") .. target.Name
	elseif action == "SpeedPlus" or action == "SpeedMinus" or action == "SetSpeed" then
		local ok, msg = needTarget(); if not ok then return false, msg end
		if not humanoid then return false, "Target character is not ready." end
		local current = humanoid.WalkSpeed
		local nextSpeed = action == "SpeedPlus" and current + 8 or action == "SpeedMinus" and current - 8 or value
		if not nextSpeed or nextSpeed ~= nextSpeed or nextSpeed &lt; 0 or nextSpeed &gt; Config.MaxWalkSpeed then return false, "Speed must be between 0 and " .. Config.MaxWalkSpeed end
		humanoid.WalkSpeed = nextSpeed
		return true, target.Name .. " speed set to " .. tostring(nextSpeed)
	elseif action == "SetJump" then
		local ok, msg = needTarget(); if not ok then return false, msg end
		if not humanoid or not value or value ~= value or value &lt; 0 or value &gt; Config.MaxJumpPower then return false, "Jump power must be between 0 and " .. Config.MaxJumpPower end
		humanoid.UseJumpPower = true
		humanoid.JumpPower = value
		return true, target.Name .. " jump power set to " .. tostring(value)
	elseif action == "Noclip" or action == "Clip" then
		local ok, msg = needTarget(); if not ok then return false, msg end
		if not character then return false, "Target character is not ready." end
		local enabled = action == "Noclip"
		character:SetAttribute("BR_Noclip", enabled)
		if enabled then
			collisionOriginals[target.UserId] = {}
			for _, descendant in ipairs(character:GetDescendants()) do
				if descendant:IsA("BasePart") then
					collisionOriginals[target.UserId][descendant] = descendant.CanCollide
					descendant.CanCollide = false
				end
			end
		else
			for part, oldCanCollide in pairs(collisionOriginals[target.UserId] or {}) do
				if part and part.Parent then part.CanCollide = oldCanCollide end
			end
			collisionOriginals[target.UserId] = nil
		end
		AdminUpdate:FireClient(target, "NoclipState", enabled)
		return true, (enabled and "Noclip enabled for " or "Noclip disabled for ") .. target.Name
	elseif action == "Freeze" or action == "Unfreeze" then
		local ok, msg = needTarget(); if not ok then return false, msg end
		if not root or not humanoid then return false, "Target character is not ready." end
		if action == "Freeze" then
			state.wasAnchored = root.Anchored
			state.walkBeforeFreeze = humanoid.WalkSpeed
			state.jumpBeforeFreeze = humanoid.JumpPower
			root.Anchored = true
			humanoid.WalkSpeed = 0
			humanoid.JumpPower = 0
		else
			root.Anchored = state.wasAnchored == true
			humanoid.WalkSpeed = state.walkBeforeFreeze or 16
			humanoid.JumpPower = state.jumpBeforeFreeze or 50
		end
		return true, (action == "Freeze" and "Froze " or "Unfroze ") .. target.Name
	elseif action == "Heal" then
		local ok, msg = needTarget(); if not ok then return false, msg end
		if not humanoid then return false, "Target character is not ready." end
		humanoid.Health = humanoid.MaxHealth
		return true, "Healed " .. target.Name
	elseif action == "Respawn" then
		local ok, msg = needTarget(); if not ok then return false, msg end
		target:LoadCharacter()
		return true, "Respawned " .. target.Name
	elseif action == "Bring" or action == "Teleport" then
		local ok, msg = needTarget(); if not ok then return false, msg end
		local adminRoot = getRoot(admin)
		local targetRoot = getRoot(target)
		if not adminRoot or not targetRoot then return false, "Both characters must be loaded." end
		if action == "Bring" then target.Character:PivotTo(adminRoot.CFrame * CFrame.new(3, 0, 0)) else admin.Character:PivotTo(targetRoot.CFrame * CFrame.new(3, 0, 0)) end
		return true, action .. " completed."
	elseif action == "Kick" then
		local ok, msg = needTarget(); if not ok then return false, msg end
		if target == admin then return false, "You cannot kick yourself." end
		target:Kick("Removed by a Battle Rush moderator.")
		return true, "Kicked " .. target.Name
	elseif action == "Ban" then
		local id = target and target.UserId or getUserIdFromPayload(payload)
		if not id then return false, "Select a player or enter a numeric UserId." end
		if Config.OwnerUserIds[id] then return false, "You cannot ban the game owner." end
		local reason = type(payload.reason) == "string" and payload.reason:sub(1, Config.MaxReasonLength) or "Admin decision"
		return banUser(id, reason, admin)
	elseif action == "Unban" then
		local id = getUserIdFromPayload(payload)
		if not id then return false, "Enter a numeric UserId to unban." end
		if not banStore then return false, "Ban storage unavailable." end
		local ok = pcall(function() banStore:RemoveAsync("u_" .. tostring(id)) end)
		return ok, ok and ("Unbanned UserId " .. id) or "Could not remove the ban."
	elseif action == "Mute" or action == "Unmute" then
		local ok, msg = needTarget(); if not ok then return false, msg end
		local enabled = action == "Mute"
		mutedPlayers[target.UserId] = enabled
		target:SetAttribute("BR_AdminMuted", enabled)
		local channels = TextChatService:FindFirstChild("TextChannels")
		if channels then
			for _, channel in ipairs(channels:GetChildren()) do
				for _, source in ipairs(channel:GetChildren()) do
					if source:IsA("TextSource") and source.UserId == target.UserId then pcall(function() source.CanSend = not enabled end) end
				end
			end
		end
		return true, (enabled and "Muted " or "Unmuted ") .. target.Name
	elseif action == "Warn" then
		local ok, msg = needTarget(); if not ok then return false, msg end
		local reason = type(payload.reason) == "string" and payload.reason:sub(1, Config.MaxReasonLength) or "Please follow the game rules."
		AdminUpdate:FireClient(target, "Warning", reason)
		return true, "Warning sent to " .. target.Name
	elseif action == "ViewInfo" then
		local ok, msg = needTarget(); if not ok then return false, msg end
		local healthText = humanoid and string.format("%.0f / %.0f", humanoid.Health, humanoid.MaxHealth) or "Not spawned"
		local teamText = target.Team and target.Team.Name or "No team"
		sendFeedback(admin, string.format("%s | UserId %d | Team %s | Health %s | Role %s", target.Name, target.UserId, teamText, healthText, getRole(target) or "Player"))
		return true, "Player information displayed."
	elseif action == "Spectate" then
		local ok, msg = needTarget(); if not ok then return false, msg end
		AdminUpdate:FireClient(admin, "Spectate", target.UserId)
		return true, "Spectating " .. target.Name
	elseif action == "SendMessage" then
		local ok, msg = needTarget(); if not ok then return false, msg end
		local raw = type(payload.text) == "string" and payload.text:sub(1, 120) or ""
		if raw == "" then return false, "Enter a message first." end
		local success, filtered = pcall(function()
			local result = TextService:FilterStringAsync(raw, admin.UserId, Enum.TextFilterContext.PrivateChat)
			return result:GetNonChatStringForUserAsync(target.UserId)
		end)
		if not success then return false, "Message could not be filtered." end
		AdminUpdate:FireClient(target, "PrivateAdminMessage", admin.Name, filtered)
		return true, "Message sent to " .. target.Name
	elseif action == "StartMatch" then
		Workspace:SetAttribute("BR_MatchActive", true)
		return true, "Match started."
	elseif action == "EndMatch" then
		Workspace:SetAttribute("BR_MatchActive", false)
		roundToken += 1
		activeTimer = 0
		AdminUpdate:FireAllClients("RoundUpdate", "Match ended", 0)
		return true, "Match ended."
	elseif action == "ResetArena" then
		finishEvent()
		clearHazards()
		return true, "Arena hazards cleared."
	elseif action == "SetTimer" then
		if not value or value ~= value or value &lt; 1 or value &gt; 3600 then return false, "Timer must be between 1 and 3600 seconds." end
		roundToken += 1
		local token = roundToken
		activeTimer = math.floor(value)
		Workspace:SetAttribute("BR_RoundTime", activeTimer)
		task.spawn(function()
			while token == roundToken and activeTimer &gt; 0 do
				AdminUpdate:FireAllClients("RoundUpdate", "Round timer", activeTimer)
				task.wait(1)
				activeTimer -= 1
			end
			if token == roundToken and activeTimer &lt;= 0 then
				Workspace:SetAttribute("BR_MatchActive", false)
				AdminUpdate:FireAllClients("RoundUpdate", "Time up", 0)
			end
		end)
		return true, "Round timer set to " .. tostring(math.floor(value)) .. " seconds."
	elseif action == "SetTeamRed" or action == "SetTeamBlue" then
		local ok, msg = needTarget(); if not ok then return false, msg end
		target.Team = action == "SetTeamRed" and ensureTeam("Red", BrickColor.new("Really red")) or ensureTeam("Blue", BrickColor.new("Really blue"))
		return true, "Moved " .. target.Name .. " to " .. target.Team.Name
	elseif action == "Giant" or action == "Tiny" then
		local ok, msg = needTarget(); if not ok then return false, msg end
		if not character then return false, "Target character is not ready." end
		local scale = action == "Giant" and 1.65 or 0.65
		local success = pcall(function() character:ScaleTo(scale) end)
		return success, success and (target.Name .. " resized.") or "Could not resize this avatar rig."
	elseif action == "LowGravity" then
		previousGravity = Workspace.Gravity
		Workspace.Gravity = 78
		return true, "Low gravity enabled for this server."
	elseif action == "HighGravity" then
		previousGravity = Workspace.Gravity
		Workspace.Gravity = 240
		return true, "High gravity enabled for this server."
	elseif action == "Launch" then
		local ok, msg = needTarget(); if not ok then return false, msg end
		if not root then return false, "Target character is not ready." end
		root.AssemblyLinearVelocity = Vector3.new(root.AssemblyLinearVelocity.X, 85, root.AssemblyLinearVelocity.Z)
		return true, "Launched " .. target.Name
	elseif action == "Spin" then
		local ok, msg = needTarget(); if not ok then return false, msg end
		if not root then return false, "Target character is not ready." end
		root.AssemblyAngularVelocity = Vector3.new(0, 24, 0)
		task.delay(3, function() if root and root.Parent then root.AssemblyAngularVelocity = Vector3.zero end end)
		return true, "Spin effect applied to " .. target.Name
	elseif action == "Ragdoll" then
		local ok, msg = needTarget(); if not ok then return false, msg end
		if not humanoid then return false, "Target character is not ready." end
		humanoid:ChangeState(Enum.HumanoidStateType.Physics)
		task.delay(2.5, function() if humanoid and humanoid.Parent then humanoid:ChangeState(Enum.HumanoidStateType.GettingUp) end end)
		return true, "Ragdoll effect applied to " .. target.Name
	elseif action == "Effects" then
		local ok, msg = needTarget(); if not ok then return false, msg end
		if not root then return false, "Target character is not ready." end
		local sparkles = Instance.new("Sparkles")
		sparkles.Name = "BR_AdminSparkles"
		sparkles.SparkleColor = Color3.fromRGB(194, 110, 255)
		sparkles.Parent = root
		Debris:AddItem(sparkles, 12)
		return true, "Temporary effect added to " .. target.Name
	elseif action == "StartAdminAbuse" then
		return startAbuseMode()
	elseif action == "EndAdminAbuse" then
		return endAbuseMode()
	elseif action == "TriggerEvent" then
		local eventName = type(payload.eventName) == "string" and payload.eventName or ""
		if not table.find(Config.Events, eventName) then return false, "Unknown event." end
		if not abuseActive then
			local started, startMessage = startAbuseMode()
			if not started then return false, startMessage end
		end
		return startEvent(eventName)
	elseif action == "StopEvent" then
		finishEvent()
		return true, "Current event stopped."
	elseif action == "Announce" or action == "GlobalMessage" then
		local raw = type(payload.text) == "string" and payload.text or ""
		local ok, filteredOrMessage = filteredBroadcast(admin, raw)
		if not ok then return false, filteredOrMessage end
		if action == "Announce" then
			AdminUpdate:FireAllClients("Announcement", filteredOrMessage, admin.Name)
			return true, "Announcement sent to this server."
		else
			local publishOk = pcall(function() MessagingService:PublishAsync("BattleRush_GlobalAdminMessage", {text = filteredOrMessage, by = admin.Name}) end)
			if not publishOk then return false, "Cross-server message failed. Enable/publish MessagingService support and try again." end
			return true, "Global message sent to connected servers."
		end
	elseif action == "ToggleDoubleXP" then
		doubleXP = not doubleXP
		Workspace:SetAttribute("BR_DoubleXP", doubleXP)
		AdminUpdate:FireAllClients("DoubleXP", doubleXP)
		return true, "Double XP is now " .. (doubleXP and "ON" or "OFF") .. ". XP scripts can check Workspace:GetAttribute('BR_DoubleXP')."
	elseif action == "LockServer" then
		serverLocked = true
		Workspace:SetAttribute("BR_ServerLocked", true)
		return true, "Server locked. New non-admin players will be removed."
	elseif action == "UnlockServer" then
		serverLocked = false
		Workspace:SetAttribute("BR_ServerLocked", false)
		return true, "Server unlocked."
	elseif action == "Shutdown" then
		serverLocked = true
		Workspace:SetAttribute("BR_ServerLocked", true)
		for _, player in ipairs(Players:GetPlayers()) do
			if player ~= admin then player:Kick("This Battle Rush server is shutting down.") end
		end
		task.delay(1, function()
			if admin.Parent == Players then admin:Kick("Battle Rush server shutdown by an owner/admin.") end
		end)
		return true, "Shutdown started."
	elseif action == "AddAdmin" or action == "AddModerator" then
		local id = getUserIdFromPayload(payload)
		if not id then return false, "Enter a valid numeric UserId." end
		if Config.OwnerUserIds[id] then return false, "That UserId is already an owner." end
		roster[tostring(id)] = action == "AddAdmin" and "Admin" or "Moderator"
		local saved = saveRoster()
		local onlineTarget = Players:GetPlayerByUserId(id)
		if onlineTarget then AdminUpdate:FireClient(onlineTarget, "RoleUpdate") end
		return true, "Added UserId " .. id .. " as " .. roster[tostring(id)] .. (saved and " (saved)." or " (session only: DataStore unavailable).")
	elseif action == "RemoveAdmin" then
		local id = getUserIdFromPayload(payload)
		if not id then return false, "Enter a valid numeric UserId." end
		if Config.OwnerUserIds[id] then return false, "The owner cannot be removed from the roster." end
		roster[tostring(id)] = nil
		local saved = saveRoster()
		local onlineTarget = Players:GetPlayerByUserId(id)
		if onlineTarget then AdminUpdate:FireClient(onlineTarget, "RoleRevoked") end
		return true, "Removed admin access for UserId " .. id .. (saved and "." or " (session only: DataStore unavailable).")
	elseif action == "ToggleCommands" then
		if not isOwner(admin) then return false, "Only the owner can toggle all admin commands." end
		Config.CommandsEnabled = not Config.CommandsEnabled
		Workspace:SetAttribute("BR_AdminCommandsEnabled", Config.CommandsEnabled)
		return true, "Admin commands are now " .. (Config.CommandsEnabled and "enabled." or "disabled.")
	elseif action == "GiveCoins" or action == "GiveXP" then
		local ok, msg = needTarget(); if not ok then return false, msg end
		if not value or value ~= value or value &lt; 1 or value &gt; 100000 then return false, "Reward amount must be between 1 and 100000." end
		local leaderstats = target:FindFirstChild("leaderstats")
		local statName = action == "GiveCoins" and "Coins" or "XP"
		local stat = leaderstats and leaderstats:FindFirstChild(statName)
		if not stat or not (stat:IsA("IntValue") or stat:IsA("NumberValue")) then
			return false, "This game has no leaderstats." .. statName .. " value. Add it to enable this reward button."
		end
		stat.Value += math.floor(value)
		return true, "Gave " .. math.floor(value) .. " " .. statName .. " to " .. target.Name
	end
	return false, "Command is not implemented."
end

GetSnapshot.OnServerInvoke = function(player: Player)
	local role = getRole(player)
	if not role then return {isAdmin = false} end
	local logs = {}
	for i = 1, math.min(#commandLogs, 25) do table.insert(logs, commandLogs[i]) end
	local adminList = {}
	if role == "Owner" then
		for id, assignedRole in pairs(roster) do table.insert(adminList, {userId = tonumber(id), role = assignedRole}) end
	end
	return {
		isAdmin = true,
		role = role,
		commandsEnabled = Config.CommandsEnabled,
		abuseActive = abuseActive,
		activeEvent = activeEventName or "",
		doubleXP = doubleXP,
		serverLocked = serverLocked,
		logs = logs,
		adminList = adminList,
	}
end

AdminAction.OnServerEvent:Connect(function(player: Player, payload: any)
	if type(payload) ~= "table" then return end
	local now = os.clock()
	if lastActionAt[player.UserId] and now - lastActionAt[player.UserId] &lt; Config.RemoteCooldown then return end
	lastActionAt[player.UserId] = now
	if not getRole(player) then return end
	local action = payload.action
	if type(action) ~= "string" or #action &gt; 40 then return end
	local ok, success, message = pcall(function()
		local result, response = runAction(player, payload)
		return result, response
	end)
	if not ok then
		warn("[BattleRushAdmin] Command error: " .. tostring(success))
		sendFeedback(player, "Command failed safely. Check Server Output for details.", true)
		return
	end
	local succeeded = success == true
	local response = type(message) == "string" and message or "Command finished."
	sendFeedback(player, response, not succeeded)
	if succeeded then addLog(player, action, type(payload.target) == "string" and payload.target or (payload.targetUserId and tostring(payload.targetUserId) or "-")) end
end)

FlyControl.OnServerEvent:Connect(function(player: Player, moveVector: any)
	local character = player.Character
	local root = getRoot(player)
	if not character or not root or character:GetAttribute("BR_Flying") ~= true then return end
	if typeof(moveVector) ~= "Vector3" then return end
	if moveVector.X ~= moveVector.X or moveVector.Y ~= moveVector.Y or moveVector.Z ~= moveVector.Z then return end
	if math.abs(moveVector.X) == math.huge or math.abs(moveVector.Y) == math.huge or math.abs(moveVector.Z) == math.huge then return end
	local now = os.clock()
	if lastFlyAt[player.UserId] and now - lastFlyAt[player.UserId] &lt; 0.045 then return end
	lastFlyAt[player.UserId] = now
	local velocity = moveVector
	if velocity.Magnitude &gt; Config.MaxFlySpeed then velocity = velocity.Unit * Config.MaxFlySpeed end
	local bodyVelocity = root:FindFirstChild("BR_FlyVelocity")
	if bodyVelocity and bodyVelocity:IsA("BodyVelocity") then bodyVelocity.Velocity = velocity end
	local bodyGyro = root:FindFirstChild("BR_FlyGyro")
	if bodyGyro and bodyGyro:IsA("BodyGyro") and Vector3.new(velocity.X, 0, velocity.Z).Magnitude &gt; 1 then
		bodyGyro.CFrame = CFrame.lookAt(root.Position, root.Position + Vector3.new(velocity.X, 0, velocity.Z))
	end
end)

local function onCharacter(player: Player, character: Model)
	character:SetAttribute("BR_GodMode", false)
	character:SetAttribute("BR_Flying", false)
	character:SetAttribute("BR_Noclip", false)
	if abuseActive then
		task.wait(0.6)
		local root = getRoot(player)
		if root then returnCFrames[player.UserId] = root.CFrame end
		if player.Parent == Players then teleportToArena(player) end
	end
end

Players.PlayerAdded:Connect(function(player)
	if serverLocked and not getRole(player) then
		player:Kick("This Battle Rush server is locked.")
		return
	end
	if banStore then
		local ok, banData = pcall(function() return banStore:GetAsync("u_" .. tostring(player.UserId)) end)
		if ok and banData ~= nil then
			local reason = type(banData) == "table" and tostring(banData.reason or "No reason supplied") or "Admin decision"
			player:Kick("You are banned from this experience. Reason: " .. reason)
			return
		end
	end
	player.CharacterAdded:Connect(function(character) onCharacter(player, character) end)
	if player.Character then task.spawn(onCharacter, player, player.Character) end
end)

Players.PlayerRemoving:Connect(function(player)
	lastActionAt[player.UserId] = nil
	lastFlyAt[player.UserId] = nil
	returnCFrames[player.UserId] = nil
	if godConnections[player.UserId] then godConnections[player.UserId]:Disconnect(); godConnections[player.UserId] = nil end
	invisibleOriginals[player.UserId] = nil
	collisionOriginals[player.UserId] = nil
	playerState[player.UserId] = nil
end)

-- Cross-server announcements are filtered before publish; received text has already been filtered.
pcall(function()
	MessagingService:SubscribeAsync("BattleRush_GlobalAdminMessage", function(message)
		local data = message.Data
		if type(data) == "table" and type(data.text) == "string" then
			AdminUpdate:FireAllClients("Announcement", data.text:sub(1, Config.MaxAnnouncementLength), tostring(data.by or "Battle Rush Admin"))
		end
	end)
end)

-- Optional /admin chat command for TextChatService places. The on-screen crown button is also provided.
local adminChatCommand = TextChatService:FindFirstChild("BattleRushAdminCommand")
if not adminChatCommand then
	adminChatCommand = Instance.new("TextChatCommand")
	adminChatCommand.Name = "BattleRushAdminCommand"
	adminChatCommand.PrimaryAlias = "/admin"
	adminChatCommand.Parent = TextChatService
end
(adminChatCommand :: TextChatCommand).Triggered:Connect(function(textSource)
	local player = Players:GetPlayerByUserId(textSource.UserId)
	if player and getRole(player) then AdminUpdate:FireClient(player, "OpenPanel") end
end)

Workspace:SetAttribute("BR_AdminCommandsEnabled", Config.CommandsEnabled)
Workspace:SetAttribute("BR_AdminAbuseActive", false)
Workspace:SetAttribute("BR_ActiveEvent", "")
Workspace:SetAttribute("BR_DoubleXP", false)
print("[BattleRushAdmin] Server loaded. Replace Config.OwnerUserIds[123456789] with your UserId.")
