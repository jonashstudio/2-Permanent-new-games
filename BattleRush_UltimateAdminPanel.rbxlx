	addGridButton(match, "▶ START MATCH", "StartMatch", GREEN)
	addGridButton(match, "■ END MATCH", "EndMatch", RED)
	addGridButton(match, "↻ RESET ARENA", "ResetArena")
	addGridButton(match, "SET RED TEAM", "SetTeamRed")
	addGridButton(match, "SET BLUE TEAM", "SetTeamBlue")
	local timerSection = makeSection(battlePage, "ROUND TIMER")
	local timerRow = Instance.new("Frame")
	timerRow.BackgroundTransparency = 1
	timerRow.Size = UDim2.new(1, -8, 0, 42)
	timerRow.Parent = timerSection
	local timerBox = makeTextBox(timerRow, "Seconds (1-3600)", UDim2.fromOffset(0, 2), UDim2.new(0.72, -4, 0, 38))
	local timerSet = makeButton(timerRow, "SET TIMER", function() fire("SetTimer", {value = tonumber(timerBox.Text)}) end, PURPLE, 38)
	timerSet.Position = UDim2.new(0.73, 0, 0, 2)
	timerSet.Size = UDim2.new(0.27, -4, 0, 38)

	local funPage = createPage("Fun", pageHost)
	local funSection = makeSection(funPage, "FUN COMMANDS")
	addGridButton(funSection, "GIANT MODE", "Giant")
	addGridButton(funSection, "TINY MODE", "Tiny")
	addGridButton(funSection, "LOW GRAVITY", "LowGravity")
	addGridButton(funSection, "HIGH GRAVITY", "HighGravity")
	addGridButton(funSection, "LAUNCH", "Launch")
	addGridButton(funSection, "SPIN", "Spin")
	addGridButton(funSection, "RAGDOLL", "Ragdoll")
	addGridButton(funSection, "SPECIAL EFFECTS", "Effects")

	local abusePage = createPage("Admin Abuse", pageHost)
	local abuseSection = makeSection(abusePage, "ADMIN ABUSE FIGHT")
	addGridButton(abuseSection, "👑 START ADMIN ABUSE", "StartAdminAbuse", PURPLE)
	addGridButton(abuseSection, "END ADMIN ABUSE", "EndAdminAbuse", RED)
	addGridButton(abuseSection, "STOP CURRENT EVENT", "StopEvent", RED)
	local eventSection = makeSection(abusePage, "MANUAL RANDOM EVENTS")
	local eventNames = {"Meteor Shower", "Rising Lava", "Lightning Storm", "Disaster Rain", "Tornado", "Earthquake", "Low Gravity"}
	for _, eventName in ipairs(eventNames) do
		local display = eventName == "Meteor Shower" and "☄ METEOR SHOWER" or eventName:upper()
		makeButton(eventSection, display, function() fire("TriggerEvent", {eventName = eventName}) end, PANEL_LIGHT)
	end
	local howto = makeLabel(abusePage, "When Admin Abuse starts, all players are moved to the studded arena. Random events rotate automatically until an admin ends the mode.", UDim2.new(1, -12, 0, 56), UDim2.fromOffset(4, 0), Enum.Font.Gotham, MUTED)
	howto.TextSize = 12

	local gamePage = createPage("Game", pageHost)
	local gameSection = makeSection(gamePage, "GAME MANAGEMENT")
	addGridButton(gameSection, "GLOBAL ANNOUNCE", "Announce", GOLD)
	addGridButton(gameSection, "CROSS-SERVER MESSAGE", "GlobalMessage", GOLD)
	addGridButton(gameSection, "DOUBLE XP TOGGLE", "ToggleDoubleXP")
	addGridButton(gameSection, "LOCK SERVER", "LockServer", RED)
	addGridButton(gameSection, "UNLOCK SERVER", "UnlockServer", GREEN)
	addGridButton(gameSection, "SHUTDOWN SERVER", "Shutdown", RED)
	makeTextAction(gamePage, "ANNOUNCEMENT TEXT", "Message shown to everyone in this server", "Announce")
	makeTextAction(gamePage, "GLOBAL MESSAGE", "Filtered message sent across servers", "GlobalMessage")
	local gameNote = makeLabel(gamePage, "Double XP sets Workspace attribute BR_DoubleXP. Your XP-award script must read this attribute to apply the multiplier. Rewards require existing leaderstats Coins / XP values.", UDim2.new(1, -10, 0, 54), UDim2.fromOffset(4, 0), Enum.Font.Gotham, MUTED)
	gameNote.TextSize = 11

	local settingsPage = createPage("Settings", pageHost)
	local adminSettings = makeSection(settingsPage, "ADMIN ROSTER (OWNER ONLY)")
	local rosterField = makeFieldRow(settingsPage, "UserId to manage", "Enter numeric Roblox UserId", function(box) userIdBox = box end)
	addGridButton(adminSettings, "ADD ADMIN", "AddAdmin", PURPLE)
	addGridButton(adminSettings, "ADD MODERATOR", "AddModerator")
	addGridButton(adminSettings, "REMOVE ACCESS", "RemoveAdmin", RED)
	addGridButton(adminSettings, "TOGGLE COMMANDS", "ToggleCommands", GOLD)
	local settingNote = makeLabel(settingsPage, "Only the Owner can edit the admin roster and toggle the command system. Admins and Moderators have different server-side permissions. Put your UserId in Config.lua to claim Owner access.", UDim2.new(1, -10, 0, 65), UDim2.fromOffset(4, 0), Enum.Font.Gotham, MUTED)
	settingNote.TextSize = 11

	local logsPage = createPage("Logs", pageHost)
	local logsTitle = makeLabel(logsPage, "RECENT ADMIN COMMAND LOGS", UDim2.new(1, -8, 0, 30), UDim2.new(), Enum.Font.GothamBlack, TEXT)
	logsTitle.TextSize = 16
	local logsHolder = Instance.new("Frame")
	logsHolder.BackgroundColor3 = PANEL
	logsHolder.Size = UDim2.new(1, -8, 0, 10)
	logsHolder.AutomaticSize = Enum.AutomaticSize.Y
	logsHolder.Parent = logsPage
	corner(logsHolder, 10)
	stroke(logsHolder, DEEP_PURPLE, 1)
	local logsList = Instance.new("UIListLayout")
	logsList.Padding = UDim.new(0, 5)
	logsList.Parent = logsHolder
	local function addLogEntry(entry)
		local line = makeLabel(logsHolder, string.format("[%s] %s  •  %s  →  %s", tostring(entry.time or "--:--"), tostring(entry.actor or "Admin"), tostring(entry.action or "Command"), tostring(entry.target or "-")), UDim2.new(1, -14, 0, 28), UDim2.fromOffset(7, 0), Enum.Font.Gotham, MUTED)
		line.TextSize = 11
		line.TextTruncate = Enum.TextTruncate.AtEnd
	end
	addLiveLogEntry = addLogEntry
	for _, entry in ipairs(snapshot.logs or {}) do addLogEntry(entry) end

	showPage("Main")
	adminButton.Activated:Connect(function() mainFrame.Visible = not mainFrame.Visible end)
	local function resizeMain()
		local viewport = Workspace.CurrentCamera and Workspace.CurrentCamera.ViewportSize or Vector2.new(800, 600)
		if viewport.X < 560 then
			mainFrame.Size = UDim2.new(0.97, 0, 0.91, 0)
			header.Size = UDim2.new(1, 0, 0, 54)
			title.TextSize = 14
			subtitle.TextSize = 9
			pageHost.Position = UDim2.fromOffset(7, 106)
			pageHost.Size = UDim2.new(1, -14, 1, -113)
			tabs.Position = UDim2.fromOffset(6, 58)
			tabs.Size = UDim2.new(1, -12, 0, 42)
			adminButton.Size = UDim2.fromOffset(108, 40)
		else
			mainFrame.Size = UDim2.new(0.94, 0, 0.88, 0)
		end
	end
	resizeMain()
	if Workspace.CurrentCamera then Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(resizeMain) end

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then return end
		if input.KeyCode == Enum.KeyCode.F4 then mainFrame.Visible = not mainFrame.Visible end
	end)
end

if snapshot.isAdmin then
	createAdminInterface()
else
	-- Players without admin access still receive public round and event announcements.
	print("[BattleRushAdmin] Player UI loaded without admin privileges.")
end

local function setNoclip(enabled)
	-- The server changes/restores collision state. This flag only mirrors the server-approved mode.
	currentNoclip = enabled
end

local function createFlyControls()
	local up = makeButton(screenGui, "▲", function() verticalFly = 1 end, DEEP_PURPLE, 42)
	up.Name = "FlyUpButton"
	up.AnchorPoint = Vector2.new(1, 1)
	up.Position = UDim2.new(1, -20, 1, -130)
	up.Size = UDim2.fromOffset(52, 42)
	local down = makeButton(screenGui, "▼", function() verticalFly = -1 end, DEEP_PURPLE, 42)
	down.Name = "FlyDownButton"
	down.AnchorPoint = Vector2.new(1, 1)
	down.Position = UDim2.new(1, -20, 1, -82)
	down.Size = UDim2.fromOffset(52, 42)
	up.MouseButton1Down:Connect(function() verticalFly = 1 end)
	up.MouseButton1Up:Connect(function() verticalFly = 0 end)
	down.MouseButton1Down:Connect(function() verticalFly = -1 end)
	down.MouseButton1Up:Connect(function() verticalFly = 0 end)
	return up, down
end

local flyUpButton, flyDownButton
local function setFlying(enabled)
	currentFly = enabled
	if enabled then
		if UserInputService.TouchEnabled and not flyUpButton then flyUpButton, flyDownButton = createFlyControls() end
	else
		if flyUpButton then flyUpButton:Destroy(); flyUpButton = nil end
		if flyDownButton then flyDownButton:Destroy(); flyDownButton = nil end
		verticalFly = 0
	end
end

RunService.RenderStepped:Connect(function()
	if currentFly then
		local camera = Workspace.CurrentCamera
		local humanoid = localPlayer.Character and localPlayer.Character:FindFirstChildOfClass("Humanoid")
		if camera and humanoid then
			local move = humanoid.MoveDirection * 42
			local vertical = verticalFly
			if UserInputService:IsKeyDown(Enum.KeyCode.E) or UserInputService:IsKeyDown(Enum.KeyCode.Space) then vertical = 1 end
			if UserInputService:IsKeyDown(Enum.KeyCode.Q) or UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then vertical = -1 end
			local vector = Vector3.new(move.X, vertical * 34, move.Z)
			FlyControl:FireServer(vector)
		end
	end
end)

local shakeUntil = 0
local shakeConnection
local clientEventToken = 0
local function screenShake(duration)
	shakeUntil = os.clock() + math.clamp(tonumber(duration) or 3, 1, 50)
	if shakeConnection then return end
	shakeConnection = RunService.RenderStepped:Connect(function()
		if os.clock() >= shakeUntil then
			shakeConnection:Disconnect()
			shakeConnection = nil
			return
		end
		local camera = Workspace.CurrentCamera
		if camera then
			local offset = Vector3.new((math.random() - 0.5) * 0.22, (math.random() - 0.5) * 0.22, 0)
			camera.CFrame = camera.CFrame * CFrame.new(offset)
		end
	end)
end

AdminUpdate.OnClientEvent:Connect(function(kind, a, b, c)
	if kind == "Feedback" then
		notify(a, b)
	elseif kind == "Announcement" then
		notify("📢 " .. tostring(a) .. "  —  " .. tostring(b or "Battle Rush"), false)
	elseif kind == "EventStart" then
		if statusLabelGlobal then statusLabelGlobal.Text = "Admin Abuse: ACTIVE  •  Event: " .. tostring(a) end
		clientEventToken += 1
		local token = clientEventToken
		local duration = math.clamp(tonumber(b) or 40, 1, 180)
		alert.BackgroundColor3 = Color3.fromRGB(74, 27, 32)
		alert.TextTransparency = 0
		alert.BackgroundTransparency = 0.04
		alert.Visible = true
		task.spawn(function()
			for remaining = duration, 1, -1 do
				if token ~= clientEventToken then return end
				alert.Text = "☄ RANDOM EVENT: " .. tostring(a) .. "  •  SURVIVE!  •  " .. tostring(remaining) .. "s"
				task.wait(1)
			end
		end)
	elseif kind == "EventEnd" then
		if statusLabelGlobal then statusLabelGlobal.Text = "Admin Abuse: ACTIVE  •  Event: None" end
		clientEventToken += 1
		notify("Event complete! Get ready for the next one.", false)
	elseif kind == "Warning" then
		notify("ADMIN WARNING: " .. tostring(a), true)
	elseif kind == "PrivateAdminMessage" then
		notify("Message from " .. tostring(a) .. ": " .. tostring(b), false)
	elseif kind == "FlyState" then
		setFlying(a == true)
	elseif kind == "NoclipState" then
		setNoclip(a == true)
	elseif kind == "OpenPanel" then
		if mainFrame then mainFrame.Visible = true end
	elseif kind == "RoleUpdate" then
		local refreshedOk, refreshed = pcall(function() return GetSnapshot:InvokeServer() end)
		if refreshedOk and type(refreshed) == "table" and refreshed.isAdmin then
			snapshot = refreshed
			adminRole = refreshed.role or "Admin"
			if not mainFrame then createAdminInterface() end
			if adminButton then adminButton.Visible = true end
		end
	elseif kind == "RoleRevoked" then
		if mainFrame then mainFrame:Destroy(); mainFrame = nil end
		if adminButton then adminButton:Destroy(); adminButton = nil end
	elseif kind == "Spectate" then
		local target = Players:GetPlayerByUserId(tonumber(a) or -1)
		local camera = Workspace.CurrentCamera
		if camera and target and target.Character then
			if spectateTarget == target then
				spectateTarget = nil
				camera.CameraSubject = localPlayer.Character and localPlayer.Character:FindFirstChildOfClass("Humanoid")
			else
				spectateTarget = target
				camera.CameraSubject = target.Character:FindFirstChildOfClass("Humanoid")
			end
		end
	elseif kind == "ScreenShake" then
		screenShake(a)
	elseif kind == "RoundUpdate" then
		notify(tostring(a) .. (tonumber(b) and (" • " .. tostring(b) .. "s") or ""), false)
	elseif kind == "DoubleXP" then
		if statusLabelGlobal then statusLabelGlobal.Text = "Double XP: " .. (a and "ON" or "OFF") end
		notify("DOUBLE XP " .. (a and "ENABLED" or "DISABLED"), false)
	elseif kind == "ModeState" then
		if statusLabelGlobal then statusLabelGlobal.Text = "Admin Abuse: " .. (a and "ACTIVE" or "OFF") .. "  •  Event: " .. (a and "Starting" or "None") end
	elseif kind == "LogEntry" then
		-- Logs are only sent to authorized admins by the server.
		if addLiveLogEntry and type(a) == "table" then addLiveLogEntry(a) end
	end
end)

localPlayer.CharacterAdded:Connect(function()
	if currentNoclip then setNoclip(false) end
	if currentFly then setFlying(false) end
end)

if localPlayer:GetAttribute("BR_AdminMuted") then
	-- Muting is enforced on the server through TextChatService TextSources where supported.
end
]]></ProtectedString></Properties></Item></Item></Item>
</roblox>
