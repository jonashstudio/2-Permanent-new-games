	addGridButton(modSection, "SEND MESSAGE", "SendMessage")
	local reasonField = makeFieldRow(moderationPage, "Reason / UserId", "Reason for kick, ban or warning", function(box) reasonBox = box end)
	local noteField = makeTextAction(moderationPage, "PRIVATE MESSAGE", "Message to selected player", "SendMessage")

	local battlePage = createPage("Battle", pageHost)
