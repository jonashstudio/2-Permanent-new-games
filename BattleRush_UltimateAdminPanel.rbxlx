	tabs.BackgroundTransparency = 1
	tabs.BorderSizePixel = 0
	tabs.ScrollBarThickness = 3
	tabs.ScrollingDirection = Enum.ScrollingDirection.X
	tabs.CanvasSize = UDim2.new(0, 0, 0, 0)
	tabs.AutomaticCanvasSize = Enum.AutomaticSize.X
	tabs.Parent = mainFrame
	local tabList = Instance.new("UIListLayout")
	tabList.FillDirection = Enum.FillDirection.Horizontal
	tabList.Padding = UDim.new(0, 6)
	tabList.Parent = tabs

	local pageHost = Instance.new("Frame")
	pageHost.Position = UDim2.fromOffset(10, 112)
	pageHost.Size = UDim2.new(1, -20, 1, -122)
	pageHost.BackgroundTransparency = 1
	pageHost.Parent = mainFrame

	local tabNames = {"Main", "Players", "Moderation", "Battle", "Fun", "Admin Abuse", "Game", "Settings", "Logs"}
	for _, tabName in ipairs(tabNames) do
		local tabButton = makeButton(tabs, tabName, function() showPage(tabName) end, PANEL_LIGHT, 34)
		tabButton.Size = UDim2.fromOffset(tabName == "Admin Abuse" and 116 or 92, 34)
		tabButtons[tabName] = tabButton
	end
	
	local mainPage = createPage("Main", pageHost)
	local quick = makeSection(mainPage, "QUICK ACTIONS")
	addGridButton(quick, "▶ START MATCH", "StartMatch", GREEN)
	addGridButton(quick, "■ END MATCH", "EndMatch", RED)
	addGridButton(quick, "↻ RESET ARENA", "ResetArena")
	addGridButton(quick, "✦ DOUBLE XP", "ToggleDoubleXP", GOLD)
	addGridButton(quick, "🔒 LOCK SERVER", "LockServer")
	addGridButton(quick, "🔓 UNLOCK SERVER", "UnlockServer")
	local status = makeSection(mainPage, "LIVE SERVER STATUS")
	local statusLabel = makeLabel(status, "Admin Abuse: " .. (snapshot.abuseActive and "ACTIVE" or "OFF") .. "     •     Event: " .. (snapshot.activeEvent ~= "" and snapshot.activeEvent or "None") .. "     •     Double XP: " .. tostring(snapshot.doubleXP), UDim2.new(1, -8, 0, 42), UDim2.fromOffset(4, 2), Enum.Font.GothamBold, TEXT)
	statusLabel.TextSize = 14
	statusLabelGlobal = statusLabel

	local playersPage = createPage("Players", pageHost)
	local targetSection = makeSection(playersPage, "TARGET PLAYER")
