	header.BorderSizePixel = 0
	header.Parent = mainFrame
	studs(header, 8)
	local title = makeLabel(header, "⚡ BATTLE RUSH  /  ULTIMATE ADMIN", UDim2.new(1, -112, 0, 28), UDim2.fromOffset(16, 7), Enum.Font.GothamBlack, TEXT)
	title.TextSize = 18
	local subtitle = makeLabel(header, "SERVER CONTROL • ROLE: " .. string.upper(adminRole), UDim2.new(1, -130, 0, 16), UDim2.fromOffset(17, 34), Enum.Font.Gotham, MUTED)
	subtitle.TextSize = 10
	local close = makeButton(header, "✕", function() mainFrame.Visible = false end, RED, 38)
